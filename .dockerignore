# Build context exclusions — keep the Docker context small & builds fast.
# (Without this, node_modules + backups/*.sql get shipped to the daemon,
#  which stalls/OOM-kills the build.)
node_modules
.git
.next
backups
*.sql
*.sql.gz
*.dump
npm-debug.log
.env*
!.env.example
Dockerfile
.dockerignore
.DS_Store
coverage
.vscode
.idea

# Presentation artifacts — never needed at runtime, keep them out of the image.
Inventre_Platform_Overview.pptx
Inventre_Platform_Overview.pdf
inventre_deck_builder.py

# Data artefacts — never needed at build or runtime. Dockerfile does
# `COPY . .` in the builder stage, so this keeps ~70 MB out of the
# build context. The backfill scripts that read data/imports/ run on
# the host via tsx, never inside the image.
data
