# Prettier still honours this file (unlike ESLint 9, which dropped
# .eslintignore in favour of the `ignores` key in eslint.config.mjs).

# Generated build output
.next/
.next-*/
dist/
build/
node_modules/

# esbuild bundle, regenerated by the Dockerfile and by deploy.sh from
# db/migrate.ts. Formatting a bundler's output is meaningless.
db/migrate.js

# Rollback snapshots: verbatim copies of pages as they stood before a
# specific deploy, kept for recovery. They are evidence, not source, and
# reformatting them would destroy the thing that makes them useful — being
# byte-comparable with what was live.
.rollback-*/

# Local operational output
db_backups/
backups/
public.r2-backup/
tmp/
data/

# Lockfiles and generated snapshots
package-lock.json
pnpm-lock.yaml
**/meta/*_snapshot.json
