# /etc/cron.d/inventre-erp — production scheduled jobs.
# ONE shared secret, CRON_TOKEN, sourced from .env.deploy (mode 640) on every
# line; nothing secret lives in this file. All /api/cron routes authenticate
# with `Authorization: Bearer $CRON_TOKEN` (server/cron-auth.ts).
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV=/root/Inventre/.env.deploy
APP=http://127.0.0.1:3010
*/1  * * * * root . $ENV && curl -fsS -m 30  -X POST -H "Authorization: Bearer $CRON_TOKEN" $APP/api/cron/erp-drain >> /var/log/inventre-erp-drain.log 2>&1
*/1  * * * * root sleep 30; . $ENV && curl -fsS -m 30  -X POST -H "Authorization: Bearer $CRON_TOKEN" $APP/api/cron/erp-drain >> /var/log/inventre-erp-drain.log 2>&1
*/1  * * * * root . $ENV && curl -fsS -m 25  -X POST -H "Authorization: Bearer $CRON_TOKEN" $APP/api/cron/erp-poll >> /var/log/inventre-erp-poll.log 2>&1
*/1  * * * * root sleep 30; . $ENV && curl -fsS -m 25  -X POST -H "Authorization: Bearer $CRON_TOKEN" $APP/api/cron/erp-poll >> /var/log/inventre-erp-poll.log 2>&1
*/10 * * * * root . $ENV && curl -fsS -m 60  -X POST -H "Authorization: Bearer $CRON_TOKEN" $APP/api/cron/erp-reconcile >> /var/log/inventre-erp-reconcile.log 2>&1
*/5  * * * * root . $ENV && curl -fsS -m 30  -X GET  -H "Authorization: Bearer $CRON_TOKEN" $APP/api/cron/ccavenue-reconcile >> /var/log/inventre-ccavenue-reconcile.log 2>&1
17   * * * * root . $ENV && curl -fsS -m 120 -X GET  -H "Authorization: Bearer $CRON_TOKEN" $APP/api/cron/ccavenue-settlement-reconcile >> /var/log/inventre-ccavenue-settlement.log 2>&1
*/2  * * * * root . $ENV && curl -fsS -m 30  -X GET  -H "Authorization: Bearer $CRON_TOKEN" $APP/api/cron/retry-webhooks >> /var/log/inventre-retry-webhooks.log 2>&1
0    2 * * * root . $ENV && curl -fsS -m 60  -X GET  -H "Authorization: Bearer $CRON_TOKEN" $APP/api/cron/auto-po >> /var/log/inventre-auto-po.log 2>&1
0  */6 * * * root . $ENV && curl -fsS -m 60  -X GET  -H "Authorization: Bearer $CRON_TOKEN" $APP/api/cron/cleanup-carts >> /var/log/inventre-cleanup-carts.log 2>&1
*/1  * * * * root . $ENV && curl -fsS -m 60  -X GET  -H "Authorization: Bearer $CRON_TOKEN" $APP/api/cron/erp-webhook-drain >> /var/log/inventre-erp-webhook-drain.log 2>&1
5    * * * * root . $ENV && curl -fsS -m 60  -X POST -H "Authorization: Bearer $CRON_TOKEN" $APP/api/cron/erp-stranded-alert >> /var/log/inventre-erp-stranded.log 2>&1
# sync-items (ERPNext item feed) is deliberately NOT scheduled: the production host cannot reach ERPNext; run it from the admin ERP page when needed.
# data-retention (DPP §6 schedule): OTP rows/codes + inactive-parent anonymise always apply; every other rule is COUNT-ONLY unless RETENTION_APPLY=1 in .env.deploy.
40   2 * * * root . $ENV && curl -fsS -m 600 -X POST -H "Authorization: Bearer $CRON_TOKEN" $APP/api/cron/data-retention >> /var/log/inventre-data-retention.log 2>&1
