node_modules
.next
.next-dev
.next-verify
out
.env
.env*.local
.env.deploy
.env.deploy.bak*
.DS_Store
*.tsbuildinfo
next-env.d.ts

# database
db/migrations/meta/_journal.json.bak
db/snapshots/
*.db
*.sqlite
*.sql.gz

# Database backups — never commit dumps (PII). Restore from the dump
# delivered out-of-band, not from the repo.
backups/*.sql
backups/*.sql.gz
backups/*.dump
backups/*.dump.gz
# Root-level dumps (production DB snapshots) — never commit
*.dump
*.sql.gz
!backups/README.md
# Per-branch migration snapshots (timestamped, no PII — only the SQL
# DDL/DML from db/migrations/ rebundled). Tracked so DBAs / ops can grab
# a single artefact off git without reassembling from individual files.
!backups/migrations-*/
!backups/migrations-*/*.sql
!backups/migrations-*/README.md
# Postgres custom-format dumps placed in db/migrations/ during local restore.
db/migrations/*.dump

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# Backfill dry-run + one-off audit output (regenerable, MB-sized JSON/CSV).
# Real migration steps belong in db/migrations/; this directory is only
# the dev-machine scratchpad that the *.ts diagnostic scripts emit.
scripts/migrate-from-erp/_reports/
scripts/migrate-from-erp/pre-backfill-snapshot.json

# build artifacts — anchored to repo root so we don't accidentally hide
# source dirs that happen to be named "build" (e.g. app/admin/.../catalog/build).
/dist
/build

# ERP product images live in public/erp-media/. Committed for easy deploy
# (~67MB / 282 files at last check). When this folder grows beyond ~200MB,
# migrate to Hetzner object storage and re-ignore.

# ERPNext probe outputs (local dev only)
.tmp/

# Reference exports from ERPNext (committed so prod can re-run backfill
# scripts from a checkout). Item (1).csv is ~41 MB — when ERP exports
# get refreshed frequently, consider git LFS or move to object storage.

# Screenshots and reference imagery
image.png
image copy.png
reference_images/
data/erpnext-items-snapshot.json

# Local backup of files moved to R2 (~142MB) — do not commit
public.r2-backup/

# Claude Code local state (per-machine scheduled-task lock, etc.)
.claude/

# Editor / save-snapshot backups generated by preflight scripts.
# Match both timestamped (file.bak.20260525-100000) and prefix-tagged
# (file.bak.preflight-1779740922) forms — both proliferate across the
# tree during long edit sessions.
*.bak.*

# Ad-hoc working assets at the repo root — screenshots, reference PDFs,
# scratch images. Keep on disk for the dev but don't track in git.
/22.png
/23.png
/DIY Chart for Measuring Uniform.pdf
backups/*.png
backups/*.docx
backups/*.pdf

# Snapshot tarballs produced by scripts/snapshot-deploy.sh — pg_dump +
# encrypted .env + minio volume, all PII-bearing. Restore artefacts, not
# source. Sit on disk for ops convenience; never commit.
backups/*.tar.gz

# Pre-update CSV snapshots (full student rosters with PII). Same rule —
# kept on disk for rollback, never committed.
backups/students-*.csv

# Ad-hoc scratch workspaces created during data migrations.
tmp/

# --- data artifacts (do not commit) ---
DEV_PROD_DIFF_*.md
SESSION_LOG_*.md
audit_grade_backfill_*.csv
celes_kidlink_orders_review_*.csv
legacy_grade_backup_*.csv
stranded_*_orders_*.csv
tsus-magicbox-remap-rollback-*.csv
unpriced_skus_*.csv
Screenshot *.png

# --- presentation artifacts (do not commit) ---
# Platform overview deck + its generator. Built from live prod numbers on
# demand; regenerate with inventre_deck_builder.py rather than committing.
# NB: deliberately NOT a blanket *.pdf — docs/guides/*.pdf are tracked.
Inventre_Platform_Overview.pptx
Inventre_Platform_Overview.pdf
inventre_deck_builder.py

# ── Data artefacts (moved out of the repo root 2026-09-09) ──────────
# Reports, ad-hoc CSV exports, vendor PDFs and decks. Not source, and
# ~70 MB of it was sitting in the root and in the Docker build context.
# data/imports/ is the exception: BOM.csv, Item (1).csv and
# Item Attribute.csv are read by the backfill scripts via
# path.resolve(process.cwd(), "data/imports/..."), so they stay tracked
# and a fresh clone still works.
/data/*
!/data/imports/

# Carries a root SSH password for the audit host. Rotate the credential
# and remove it from the script before this is ever committed.
/scripts/push-catalogue-to-audit.sh

# ── Recurring generated artefacts (added 2026-09-10) ────────────────────────
# These were cleaned out of the repo root by hand at 10:00 and were back by
# 12:25, because a deck generator writes them here on every run. Cleaning is
# not a fix; ignoring them is. Anchored to the ROOT so a legitimately tracked
# document elsewhere (docs/guides/*.pdf) is unaffected.
/*.xlsx
/*.pptx
/*.docx
/*.pdf
/*.csv
/*.jpeg
/*.jpg
/*.patch

# Local backup output: nightly pg_dump, the source bundles and their logs.
# Never committed — the dumps carry PII and the bundles are 20 MB apiece.
db_backups/

# esbuild bundle of db/migrate.ts, 2,252 lines of generated code. Both the
# Dockerfile (RUN npx esbuild … --outfile=.next/standalone/db/migrate.js) and
# scripts/deploy.sh regenerate it at build time, and scripts/start.sh runs the
# generated copy at /app/db/migrate.js — nothing reads the tracked one.
db/migrate.js

# Business deliverables never live at the repo root (F-20); they go to /root/deliverables
/*.xlsx
/*.pdf
/*.docx
