# Copy to .env.local and fill in. Never commit .env.local.

# ─── DATABASE ────────────────────────────────────────────────
# App connects via PgBouncer (port 6432). Drizzle migrations connect direct (5432).
DATABASE_URL=postgres://inventre:inventre_dev@localhost:6432/inventre
# Direct (raw Postgres) connection used by drizzle migrations.
# Host port is 55432 in the bundled docker-compose (5432 not exposed).
DATABASE_DIRECT_URL=postgres://inventre:inventre_dev@localhost:55432/inventre

# ─── REDIS ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── OBJECT STORAGE (S3-compatible) ─────────────────────────
# Local dev: MinIO. Prod: Cloudflare R2 (see .env.deploy for live values).
# R2 settings:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_PUBLIC_URL=https://pub-<hash>.r2.dev   (or custom domain)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=inventre
S3_ACCESS_KEY_ID=inventre
S3_SECRET_ACCESS_KEY=inventre_dev_secret
S3_PUBLIC_URL=http://localhost:9000/inventre

# ─── AUTH ────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
AUTH_SECRET=replace-me-with-random-32-bytes
JWT_SECRET=replace-me-with-another-random-32-bytes

# ─── SMS (MSG91 — leave empty in dev to console.log OTPs) ───
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=INVNTR

# ─── EMAIL (Resend — leave empty in dev to console.log) ─────
RESEND_API_KEY=
EMAIL_FROM=hello@inventre.in

# ─── PAYMENTS (Razorpay) ─────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── APP ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── ERP item feed (server-to-server, treat ERP_FEED_KEY as secret) ───
# See ITEMS_EXPORT_FEED.md. Triggered by /api/admin/erp/sync-items and /api/cron/sync-items.
ERP_FEED_BASE=https://audit.inventre.online
ERP_FEED_KEY=

# ─── Cron shared secret (header X-Cron-Key on /api/cron/*) ─────
CRON_KEY=

# ─── ERP media backend (local | s3) ─────────────────────────────
# local (default): mirror ERP product images into public/erp-media/
#   (host-side folder, survives `docker compose down -v`).
# s3: mirror into S3/MinIO via the existing S3_* env vars above.
ERP_MEDIA_BACKEND=local
# Override the folder if you want to keep files outside the Next public
# tree (you'd then need to add a static route in Next to serve them).
# ERP_MEDIA_LOCAL_DIR=public/erp-media
# ERP_MEDIA_LOCAL_URL=/erp-media

# ─── Legacy ERPNext API (Education mirror) ──────────────────────
# Used by the Schools / Grades / Guardians / Students sync.
# Format: api_key:api_secret. Get from ERPNext: My Account → API Access.
ERPNEXT_BASE=https://erp.inventre.in
ERPNEXT_TOKEN=

# ─── MyClassBoard (MCB) fee + student import ────────────────────
# Nightly pull (scripts/cron-import-mcb.sh) feeds /admin/mcb so admins
# can grant per-student website access after a fee payment.
MCB_API_BASE=https://api.myclassboard.com
MCB_API_KEY=
MCB_TOKEN_ID=
# Comma-separated MCB BranchIDs. Defaults to the five branches that map to
# St Andrews (52 Keesara + 70 Suchitra), St Michaels (230 Alwal), and
# Winmore (225 Jakkur + 226 Whitefield). Discover others with
# GET /api/ClassAcademicData/GET_Branches.
MCB_BRANCH_IDS=52,70,230,225,226
MCB_ORGANISATION_ID=39
# Comma-separated AcademicYearIDs to import. 17 = 2025-26, 18 = 2026-27.
MCB_ACADEMIC_YEAR_IDS=17,18
MCB_FEE_WINDOW_DAYS=35

# ─── Data retention cron (/api/cron/data-retention, DPP §6) ────────
# Always applied, whatever this says: OTP rows > 90 d deleted, OTP codes
# > 24 h nulled, inactive parents (3 y, no student, no order) anonymised.
# 0 (default) = every other rule only COUNTS what it would touch.
# Exactly 1 = the other rules with an apply (activity log, communications,
# closed-request photos, leaver students, MCB imports) actually run.
RETENTION_APPLY=0

# ── OTP log sealing (Data Protection P-01) ─────────────────────────────
# OTP codes in otp_logs are encrypted with this key (32+ hex chars, e.g.
# `openssl rand -hex 32`). Unset ⇒ codes are not stored at all.
OTP_LOG_KEY=
# Phrase support staff type on /admin/otp-logs to reveal ONE code (logged).
# Unset ⇒ Reveal disabled. Codes are wiped 24 h after sending.
OTP_REVEAL_PHRASE=
